package ui_layouts

import "github.com/bata94/RegattaApi/internal/templates/components"

templ InternalLayout(body templ.Component, sidebarCats []ui_components.SidebarCategory, userCaps []string, username string, pageTitle string) {
  {{
    additionalScripts := []string{"/assets/js/toast.js", "/assets/js/sidebar.js", "/assets/js/attachments.js", "/assets/js/startnummern.js", "/assets/js/wasm_exec.js", "/assets/js/zeitnahme_shared.js"}
  }}

	@MinimalLayout(internalLayoutBody(body, sidebarCats, userCaps, username, pageTitle), additionalScripts...)
}

templ internalLayoutBody(body templ.Component, sidebarCats []ui_components.SidebarCategory, userCaps []string, username string, pageTitle string) {
	<div class="flex min-h-screen max-w-none">
		<!-- Desktop sidebar toggle (sibling of aside for peer to work) -->
		<input id="sidebar-drawer-desktop" type="checkbox" checked class="hidden peer" />

		<!-- Desktop sidebar (lg+) -->
		<div id="desktop-sidebar-wrap" class="hidden lg:block shrink-0 relative" style="width: 18rem;">
			<aside class="flex flex-col h-full bg-base-200 text-base-content border-r border-base-300 transition-all duration-300">
				@ui_components.Sidebar(sidebarCats, userCaps, username)
			</aside>
			<!-- Resize handle -->
			<div id="resize-handle" class="resize-handle absolute top-0 bottom-0 right-0 w-1.5 cursor-col-resize bg-base-300 hover:bg-primary transition-colors z-10"></div>
		</div>

		<!-- Shared content area -->
		<div class="flex-1 flex flex-col min-w-0 bg-base-100">
			@ui_components.TopBar(pageTitle, string(username[0]), "sidebar-drawer-mobile", "sidebar-drawer-desktop")

			<main id="main-content" class="flex-1 p-4 md:p-6 lg:p-8 overflow-auto">
				@body
			</main>
		</div>
	</div>

	<!-- Mobile sidebar overlay (< lg) -->
	<input id="sidebar-drawer-mobile" type="checkbox" class="hidden peer" />
	<label for="sidebar-drawer-mobile" class="lg:hidden fixed inset-0 bg-black/40 z-30 hidden peer-checked:block cursor-pointer"></label>
	<aside class="lg:hidden fixed inset-y-0 left-0 z-40 w-72 -translate-x-full peer-checked:translate-x-0 transition-transform duration-300 bg-base-200 text-base-content border-r border-base-300 overflow-y-auto shadow-xl">
		@ui_components.Sidebar(sidebarCats, userCaps, username)
	</aside>

	<div id="toast-container" class="toast toast-end"/>
}
