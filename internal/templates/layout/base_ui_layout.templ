package ui_layouts

import "github.com/bata94/RegattaApi/internal/templates/components"

templ MinimalLayout(body templ.Component) {
<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">

  <title>MRG Regatta</title>
  <meta name="description" content="Homepage der MRG Regatta" />

  @favicons()

  <link href="/public/css_global.css" rel="stylesheet">
  <link href="/assets/css/font-awesome.min.css" rel="stylesheet">
  <link rel="manifest" href="/assets/manifest.json" />

  <script src="/assets/js/htmx.min.js"></script>
  <script src="/assets/js/htmx-ext-response-target.js"></script>
  <script src="/assets/js/theming.js"></script>
  <script src="/assets/js/toast.js"></script>
  <script src="/assets/js/sidebar.js"></script>
  <script src="/assets/js/attachments.js"></script>
  <script src="/assets/js/startnummern.js"></script>
</head>
<body
  class="max-w-screen prose antialiased"
  hx-ext="response-targets"
>
  @body
</body>
</html>
}

templ baseLayoutBody(body templ.Component, navbarConfig ui_components.NavBarConfig) {
  <div
    class="min-h-screen max-w-none"
    hx-on:click="if (!event.target.closest('details')) document.querySelectorAll('details[open]').forEach(d => d.removeAttribute('open'))"
  >
    <nav class="w-full">
      @ui_components.Navbar(navbarConfig)
    </nav>

    <main class="max-w-screen">
      @body

    </main>
  </div>

  @ui_components.Footer()
  <div id="toast-container" class="toast toast-end"/>
}

templ BaseLayout(body templ.Component, navbarConfig ui_components.NavBarConfig) {
  @MinimalLayout(baseLayoutBody(body, navbarConfig))
}

templ favicons() {
  <link
    rel="apple-touch-icon"
    sizes="57x57"
    href="/assets/icons/ws-icons/apple-icon-57x57.png"
  />
  <link
    rel="apple-touch-icon"
    sizes="60x60"
    href="/assets/icons/ws-icons/apple-icon-60x60.png"
  />
  <link
    rel="apple-touch-icon"
    sizes="72x72"
    href="/assets/icons/ws-icons/apple-icon-72x72.png"
  />
  <link
    rel="apple-touch-icon"
    sizes="76x76"
    href="/assets/icons/ws-icons/apple-icon-76x76.png"
  />
  <link
    rel="apple-touch-icon"
    sizes="114x114"
    href="/assets/icons/ws-icons/apple-icon-114x114.png"
  />
  <link
    rel="apple-touch-icon"
    sizes="120x120"
    href="/assets/icons/ws-icons/apple-icon-120x120.png"
  />
  <link
    rel="apple-touch-icon"
    sizes="144x144"
    href="/assets/icons/ws-icons/apple-icon-144x144.png"
  />
  <link
    rel="apple-touch-icon"
    sizes="152x152"
    href="/assets/icons/ws-icons/apple-icon-152x152.png"
  />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/assets/icons/ws-icons/apple-icon-180x180.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="192x192"
    href="/assets/icons/ws-icons/android-icon-192x192.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href="/assets/icons/ws-icons/favicon-32x32.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="96x96"
    href="/assets/icons/ws-icons/favicon-96x96.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href="/assets/icons/ws-icons/favicon-16x16.png"
  />
  <link rel="manifest" href="/assets/icons/ws-icons/manifest.json" />
  <meta name="msapplication-TileColor" content="#ffffff" />
  <meta name="msapplication-TileImage" content="/ms-icon-144x144.png" />
}
