package ui_components

templ TopBar(title string, avatarFirstLetter string, mobileDrawerId string, desktopDrawerId string) {
	<div class="flex items-center justify-between px-4 py-2 border-b border-base-300 bg-base-100 h-14">
		<div class="flex items-center gap-3">
			<label for={mobileDrawerId} class="btn btn-ghost btn-sm lg:hidden cursor-pointer p-2 tooltip tooltip-right" data-tip="Sidebar umschalten">
				<img src="/assets/icons/mrg_logo.png" alt="Menu" class="w-6 h-auto" />
			</label>
			<label for={desktopDrawerId} class="btn btn-ghost btn-sm hidden lg:flex cursor-pointer p-1 tooltip tooltip-right" data-tip="Sidebar umschalten">
				<img src="/assets/icons/mrg_logo.png" alt="Menu" class="w-8 h-auto" />
			</label>
			<h2 class="topbar-title text-lg font-semibold !m-0">{title}</h2>
		</div>
		<div class="flex items-center gap-2">
			@themeSwitcher()
			@userDropdown(avatarFirstLetter)
		</div>
	</div>
}
