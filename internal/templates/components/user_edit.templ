package ui_components

import (
  "github.com/google/uuid"
	"github.com/bata94/RegattaApi/internal/crud"
	"github.com/bata94/RegattaApi/internal/sqlc"
)

templ UserEdit(u crud.User, msg string) {
  {{
    var title, uuidStr string
    if u.Uuid != uuid.Nil {
      title = "Nutzer bearbeiten"
      uuidStr = u.Uuid.String()
    } else {
      title = "Neuer Nutzer"
      uuidStr = "new"
    }

    userGroups, errUserGroups := crud.GetAllUsersGroups()
  }}
  if errUserGroups != nil {
    @ErrorBody(500, errUserGroups.Error())
    {{return}}
  }

  <div id="user_edit_dialog" class="w-full flex flex-col">
    @PageHeader(title)

    <form
      class="w-full mt-4"
      hx-post={"/internal/admin/user/" + uuidStr}
      hx-target="#user_edit_dialog"
      hx-on::response="if (event.detail.xhr.getResponseHeader('HX-Redirect')) { table_dialog.close(); htmx.ajax('GET', '/internal/admin/users', {target: 'main', swap: 'innerHTML'}); }"
    >
      if msg != "" {
        <div class="alert alert-error mb-4">
          <span>{msg}</span>
        </div>
      }

      <div class="flex flex-col gap-4">
        <div class="form-control mb-6">
          <label class="input w-full">
            <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <input type="text" name="username" class="grow" placeholder="Benutzername" value={u.Username} required />
          </label>
        </div>

        <div class="form-control mb-6">
          <label class="input w-full">
            <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
            <input
              type="password"
              name="password"
              class="grow"
              placeholder="Passwort"
              if uuidStr  == "new" {
                required
              } else {
                disabled
              }
            />
          </label>
        </div>

        <div class="mb-6 flex flex-row justify-between">
          <label class="">
            Nutzer gesperrt?
          </label>
          <input
            name="is_not_active"
            type="checkbox"
            class="toggle"
            if uuidStr  != "new" && !u.IsActive {
              checked
            }
          />
        </div>

        <div class="form-control mb-6">
          <select class="select" name="user_group_uuid" required>
            if u.Uuid != uuid.Nil {
              <option disabled >Nutzergruppe</option>
            } else {
              <option disabled selected>Nutzergruppe</option>
            }
            for _, ug := range userGroups {
              if ug.Uuid == u.UserGroup.Uuid {
                <option value={ug.Uuid.String()} selected>{ug.Name}</option>
              } else {
                <option value={ug.Uuid.String()}>{ug.Name}</option>
              }
            }
          </select>
        </div>
      </div>
      <div class="form-control mt-6 w-full">
        <button type="submit" class="btn btn-primary mx-auto">
          Speichern
          <span class="htmx-indicator loading loading-spinner loading-md"></span>
        </button>
      </div>
    </form>
  </div>
}

templ UserGroupEdit(ug sqlc.UsersGroup, msg string) {
  {{
    var title, uuidStr string
    if ug.Uuid != uuid.Nil {
      title = "Nutzergruppe bearbeiten"
      uuidStr = ug.Uuid.String()
    } else {
      title = "Neue Nutzergruppe"
      uuidStr = "new"
    }
  }}

  <div id="user_edit_dialog" class="w-full flex flex-col">
    @PageHeader(title)

    <form
      class="w-full mt-4"
      hx-post={"/internal/admin/usergroups/" + uuidStr}
      hx-target="#user_edit_dialog"
      hx-on::response="if (event.detail.xhr.getResponseHeader('HX-Redirect')) { table_dialog.close(); htmx.ajax('GET', '/internal/admin/users', {target: 'main', swap: 'innerHTML'}); }"
    >
      if msg != "" {
        <div class="alert alert-error mb-4">
          <span>{msg}</span>
        </div>
      }
      <div class="flex flex-col gap-4">
        <div class="form-control mb-6">
          Gruppenname:
          <label class="input w-full">
            <input
              type="text"
              name="name"
              class="grow"
              placeholder="Gruppenname"
              value={ug.Name}
              required
            />
          </label>
        </div>
      </div>

      <div class="mb-6 flex flex-row justify-between">
        <label class="">
          Admin Berechtigung?
        </label>
        <input
          name="allowed_admin"
          type="checkbox"
          class="toggle"
          if uuidStr  != "new" && ug.AllowedAdmin{
            checked
          }
        />
      </div>

      <div class="mb-6 flex flex-row justify-between">
        <label class="">
          Zeitnahme Berechtigung?
        </label>
        <input
          name="allowed_zeitnahme"
          type="checkbox"
          class="toggle"
          if uuidStr  != "new" && ug.AllowedZeitnahme{
            checked
          }
        />
      </div>

      <div class="mb-6 flex flex-row justify-between">
        <label class="">
          Startlisten Berechtigung?
        </label>
        <input
          name="allowed_startlisten"
          type="checkbox"
          class="toggle"
          if uuidStr  != "new" && ug.AllowedStartlisten{
            checked
          }
        />
      </div>

      <div class="mb-6 flex flex-row justify-between">
        <label class="">
          Regattabüro Berechtigung?
        </label>
        <input
          name="allowed_regattabuero"
          type="checkbox"
          class="toggle"
          if uuidStr  != "new" && ug.AllowedRegattabuero{
            checked
          }
        />
      </div>

      <div class="mb-6 flex flex-row justify-between">
        <label class="">
          Regattaleitung Berechtigung?
        </label>
        <input
          name="allowed_regattaleitung"
          type="checkbox"
          class="toggle"
          if uuidStr  != "new" && ug.AllowedRegattaleitung{
            checked
          }
        />
      </div>

      <div class="form-control mt-6 w-full">
        <button type="submit" class="btn btn-primary mx-auto">
          Speichern
          <span class="htmx-indicator loading loading-spinner loading-md"></span>
        </button>
      </div>
    </form>
  </div>
}
