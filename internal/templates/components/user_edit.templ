package ui_components

import (
  "github.com/google/uuid"
	"github.com/bata94/RegattaApi/internal/crud"
	"github.com/bata94/RegattaApi/internal/sqlc"
)

templ UserEdit(u crud.User, msg string, fieldErrors map[string]string) {
  {{
    var title, uuidStr string
    isNew := u.Uuid == uuid.Nil
    if isNew {
      title = "Neuer Nutzer"
      uuidStr = "new"
    } else {
      title = "Nutzer bearbeiten"
      uuidStr = u.Uuid.String()
    }

    userGroups, errUserGroups := crud.GetAllUsersGroups(ctx)

    selectClass := "select select-bordered w-full"
    if fieldErrors["user_group_uuid"] != "" {
      selectClass += " select-error"
    }
  }}
  if errUserGroups != nil {
    @ErrorBody(500, errUserGroups.Error())
    {{return}}
  }

  <div id="user_edit_dialog" class="w-full flex flex-col">
    @PageHeader(title)

    <form
      class="w-full mt-4"
      hx-post={"/internal/admin/user/" + uuidStr}
      hx-target="#user_edit_dialog"
      hx-on::response="if (event.detail.xhr.getResponseHeader('HX-Redirect')) { table_dialog.close(); htmx.ajax('GET', '/internal/admin/users', {target: 'main', swap: 'innerHTML'}); }"
    >
      if msg != "" {
        <div class="alert alert-error mb-4">
          <span>{msg}</span>
        </div>
      }

      <div class="flex flex-col gap-4">
        @LineInput("username", "Benutzername", u.Username, "text", true, fieldErrors["username"])

        @LineInput("password", "Passwort", "", "password", isNew, fieldErrors["password"])

        <div class="mb-6 flex flex-row justify-between">
          <label class="">
            Nutzer gesperrt?
          </label>
          <input
            name="is_not_active"
            type="checkbox"
            class="toggle"
            if !isNew && !u.IsActive {
              checked
            }
          />
        </div>

        <div class="form-control mb-6 w-full">
          <label class="label">
            <span class="label-text">Nutzergruppe</span>
          </label>
          <select
            name="user_group_uuid"
            class={selectClass}
            required
          >
            if isNew {
              <option disabled selected>Nutzergruppe</option>
            } else {
              <option disabled>Nutzergruppe</option>
            }
            for _, ug := range userGroups {
              if ug.Uuid == u.UserGroup.Uuid {
                <option value={ug.Uuid.String()} selected>{ug.Name}</option>
              } else {
                <option value={ug.Uuid.String()}>{ug.Name}</option>
              }
            }
          </select>
          if fieldErrors["user_group_uuid"] != "" {
            <span class="text-error text-sm mt-1">{fieldErrors["user_group_uuid"]}</span>
          }
        </div>
      </div>
      @SubmitButton("Speichern", Success)
    </form>
  </div>
}

templ UserGroupEdit(ug sqlc.UsersGroup, msg string) {
  {{
    var title, uuidStr string
    if ug.Uuid != uuid.Nil {
      title = "Nutzergruppe bearbeiten"
      uuidStr = ug.Uuid.String()
    } else {
      title = "Neue Nutzergruppe"
      uuidStr = "new"
    }
  }}

  <div id="user_edit_dialog" class="w-full flex flex-col">
    @PageHeader(title)

    <form
      class="w-full mt-4"
      hx-post={"/internal/admin/usergroups/" + uuidStr}
      hx-target="#user_edit_dialog"
      hx-on::response="if (event.detail.xhr.getResponseHeader('HX-Redirect')) { table_dialog.close(); htmx.ajax('GET', '/internal/admin/users', {target: 'main', swap: 'innerHTML'}); }"
    >
      if msg != "" {
        <div class="alert alert-error mb-4">
          <span>{msg}</span>
        </div>
      }
      <div class="flex flex-col gap-4">
        <div class="form-control mb-6">
          Gruppenname:
          <label class="input w-full">
            <input
              type="text"
              name="name"
              class="grow"
              placeholder="Gruppenname"
              value={ug.Name}
              required
            />
          </label>
        </div>
      </div>

      <div class="mb-6 flex flex-row justify-between">
        <label class="">
          Admin Berechtigung?
        </label>
        <input
          name="allowed_admin"
          type="checkbox"
          class="toggle"
          if uuidStr  != "new" && ug.AllowedAdmin{
            checked
          }
        />
      </div>

      <div class="mb-6 flex flex-row justify-between">
        <label class="">
          Zeitnahme Berechtigung?
        </label>
        <input
          name="allowed_zeitnahme"
          type="checkbox"
          class="toggle"
          if uuidStr  != "new" && ug.AllowedZeitnahme{
            checked
          }
        />
      </div>

      <div class="mb-6 flex flex-row justify-between">
        <label class="">
          Startlisten Berechtigung?
        </label>
        <input
          name="allowed_startlisten"
          type="checkbox"
          class="toggle"
          if uuidStr  != "new" && ug.AllowedStartlisten{
            checked
          }
        />
      </div>

      <div class="mb-6 flex flex-row justify-between">
        <label class="">
          Regattabüro Berechtigung?
        </label>
        <input
          name="allowed_regattabuero"
          type="checkbox"
          class="toggle"
          if uuidStr  != "new" && ug.AllowedRegattabuero{
            checked
          }
        />
      </div>

      <div class="mb-6 flex flex-row justify-between">
        <label class="">
          Regattaleitung Berechtigung?
        </label>
        <input
          name="allowed_regattaleitung"
          type="checkbox"
          class="toggle"
          if uuidStr  != "new" && ug.AllowedRegattaleitung{
            checked
          }
        />
      </div>

      @SubmitButton("Speichern", Success)
    </form>
  </div>
}
