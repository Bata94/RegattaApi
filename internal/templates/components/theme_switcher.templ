package ui_components

templ themeSwitcher() {
  <label class="swap swap-rotate btn btn-circle btn-ghost">
    <input type="checkbox" id="theme-toggle" class="theme-controller" value="dark" hidden onchange="localStorage.setItem('theme', this.checked ? 'dark' : 'light'); document.documentElement.setAttribute('data-theme', this.checked ? 'dark' : 'light');">

    <svg class="swap-off w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>

    <svg class="swap-on w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </label>
}
