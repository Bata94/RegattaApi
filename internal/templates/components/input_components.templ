package ui_components

import "fmt"

type InputColor int

const (
  Primary InputColor = iota
  Secondary
  Success
  Error
  Warning
  Info
  Mrgblau
)

templ SubmitButton(text string, color InputColor) {
  {{
    var btnColor string

    switch color {
    case Primary:
      btnColor = "btn-primary"
    case Secondary:
      btnColor = "btn-secondary"
    case Success:
      btnColor = "btn-success"
    case Error:
      btnColor = "btn-error"
    case Warning:
      btnColor = "btn-warning"
    case Info:
      btnColor = "btn-info"
    case Mrgblau:
      btnColor = "btn-mrgblau"
    default:
      btnColor = "btn-ghost"
    }
  }}
  <div class="form-control mt-6 !w-fit">
    <button type="submit" class={fmt.Sprintf("btn %s", btnColor)}>
      {text}
      <span class="htmx-indicator loading loading-spinner loading-md"></span>
    </button>
  </div>
}

templ DropDown(name, label string, options, values []string, selectedValue string, required bool, errorMsg string, placeholder string) {
  {{
    if values == nil {
      values = options
    }
    inputClass := "select select-bordered w-full"
    if errorMsg != "" {
      inputClass += " select-error"
    }
  }}
  <div class="form-control mb-6 w-full">
    <label class="label">
      <span class="label-text">{label}</span>
    </label>
    <select
      name={name}
      class={inputClass}
      if required {
        required
      }
    >
      if placeholder != "" {
        <option value="" disabled selected>{placeholder}</option>
      }
      for i, o := range options {
        <option value={values[i]} if values[i] == selectedValue {
          selected
        }>{o}</option>
      }
    </select>
    if errorMsg != "" {
      <span class="text-error text-sm mt-1">{errorMsg}</span>
    }
  </div>
}

templ LineInput(name, label, value, inpType string, required bool, errorMsg string) {
  {{
    inputClass := "input input-bordered w-full"
    if errorMsg != "" {
      inputClass += " input-error"
    }
  }}
  <div class="form-control mb-6 w-full">
    <label class="label">
      <span class="label-text">{label}</span>
    </label>
    <input
      if inpType == "float" {
        type="number"
        step="0.1"
      } else {
        type={inpType}
      }
      name={name}
      class={inputClass}
      value={value}
      if required {
        required
      }
    />
    if errorMsg != "" {
      <span class="text-error text-sm mt-1">{errorMsg}</span>
    }
  </div>
}

templ TextArea(name, label, value string, required bool, errorMsg string) {
  {{
    inputClass := "textarea textarea-bordered w-full"
    if errorMsg != "" {
      inputClass += " textarea-error"
    }
  }}
  <div class="form-control mb-6 w-full">
    <label class="label">
      <span class="label-text">{label}</span>
    </label>
    <textarea
      name={name}
      class={inputClass}
      if required {
        required
      }
    >{value}</textarea>
    if errorMsg != "" {
      <span class="text-error text-sm mt-1">{errorMsg}</span>
    }
  </div>
}

