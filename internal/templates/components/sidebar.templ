package ui_components

type SidebarEntry struct {
	Name         string
	URL          string
	RequiredCaps []string
}

type SidebarCategory struct {
	Name         string
	URL          string
	RequiredCaps []string
	Entries      []SidebarEntry
	IsActive     bool
}

templ sidebarCategory(cat SidebarCategory, userCaps []string) {
	if !hasCapability(userCaps, cat.RequiredCaps) {
		{{return}}
	}
	<li class="w-full">
		<details if cat.IsActive { open } class="w-full">
			<summary
				class="font-semibold text-sm cursor-pointer"
				hx-get={cat.URL}
				hx-target="#main-content"
				hx-push-url="true"
			>
				{cat.Name}
			</summary>
			<ul class="ml-2 w-full">
				for _, entry := range cat.Entries {
					@sidebarEntry(entry, userCaps)
				}
			</ul>
		</details>
	</li>
}

templ sidebarEntry(entry SidebarEntry, userCaps []string) {
	if !hasCapability(userCaps, entry.RequiredCaps) {
		{{return}}
	}
	<li class="w-full">
		<a
			class="sidebar-link text-sm w-full"
			hx-get={entry.URL}
			hx-target="#main-content"
			hx-push-url="true"
			href={entry.URL}
		>
			{entry.Name}
		</a>
	</li>
}

templ Sidebar(cats []SidebarCategory, userCaps []string, username string) {
	<div class="internal-sidebar flex flex-col h-full">
		<div class="flex items-center gap-3 px-4 py-6 border-b border-base-300">
			<img src="/assets/icons/mrg_logo.png" alt="MRG-Logo" class="w-10 h-auto" />
			<span class="text-lg font-bold text-mrgblau">MRG Regatta</span>
		</div>

		<ul class="menu p-2 gap-1 flex-1 overflow-y-auto overflow-x-hidden flex-nowrap min-h-0 w-full">
			for _, cat := range cats {
				@sidebarCategory(cat, userCaps)
			}
		</ul>

		<div class="border-t border-base-300 p-3 mt-auto">
			<div class="flex items-center gap-3 mb-2">
				<div class="avatar placeholder">
					<div class="bg-mrgblau text-neutral-content rounded-full w-10 h-10 flex items-center justify-center font-bold text-sm">
						{string(username[0])}
					</div>
				</div>
				<div class="flex-1 min-w-0">
					<p class="text-sm font-semibold truncate">{username}</p>
					<a
						class="text-xs link link-hover"
						hx-get="/internal/profil"
						hx-target="#main-content"
						hx-push-url="true"
						href="/internal/profil"
					>Profil</a>
				</div>
			</div>
			<a class="btn btn-ghost btn-sm w-full justify-start gap-2 text-xs" href="/logout">
				<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
				Ausloggen
			</a>
		</div>
	</div>
}
