package regattaleitung

import (
	"github.com/bata94/RegattaApi/internal/crud"
	"github.com/bata94/RegattaApi/internal/templates/components"
)

type EmailAttachment struct {
	ID       string
	Filename string
}

func isSelected(uuid string, selected []string) bool {
	for _, s := range selected {
		if s == uuid {
			return true
		}
	}
	return false
}

templ EmailCompose(subject, body, manualRecipients string, selectedVereine []string, allObleute bool, fieldErrors map[string]string, attachments []EmailAttachment) {
	{{
		vereine, err := crud.GetAllVerein(ctx)
	}}
	if err != nil {
		@ui_components.ErrorBody(500, err.Error())
		{{return}}
	}

	@ui_components.InternalPageDivCol() {
		@ui_components.PageHeader("E-Mail senden")

		<form
			class="w-full md:w-2/3 lg:w-1/2 md:mx-auto mt-4"
			hx-post="/internal/regattaleitung/email"
			hx-target="main"
			hx-swap="innerHTML"
			hx-encoding="multipart/form-data"
		>
			@ui_components.Toggle("all_obleute", "An alle Obleute senden", allObleute, false, fieldErrors["all_obleute"])

			<div class="form-control mb-6 w-full">
				<label class="label">
					<span class="label-text">Vereine</span>
				</label>
				<div class="flex flex-wrap gap-2">
					for _, v := range vereine {
						<label
							class="w-48 shrink-0 flex items-center gap-2 rounded-lg border border-base-300 px-3 py-2 cursor-pointer hover:bg-base-200 has-checked:border-primary has-checked:bg-primary/10"
						>
							<input
								type="checkbox"
								name="vereine"
								value={v.Uuid.String()}
								class="checkbox checkbox-primary checkbox-sm shrink-0"
								if isSelected(v.Uuid.String(), selectedVereine) {
									checked
								}
							/>
							<span class="truncate min-w-0 text-sm" title={v.Name}>{v.Name}</span>
						</label>
					}
				</div>
			</div>

			@ui_components.LineInput("manual_recipients", "Weitere Empfänger (E-Mail, durch Komma getrennt)", manualRecipients, "text", false, fieldErrors["manual_recipients"])
			@ui_components.LineInput("subject", "Betreff", subject, "text", true, fieldErrors["subject"])
			@ui_components.TextArea("body", "Nachricht", body, true, fieldErrors["body"])

			<div class="form-control mb-6 w-full">
				<label class="label">
					<span class="label-text">Anhänge</span>
				</label>
				if len(attachments) > 0 {
					<div class="flex flex-wrap gap-2 mb-2">
						for _, a := range attachments {
							<div class="attachment-chip flex items-center gap-2 rounded-lg border border-base-300 px-3 py-1.5">
								<input type="hidden" name="saved_files" value={a.ID}/>
								<span class="text-sm truncate max-w-xs" title={a.Filename}>{a.Filename}</span>
								<button type="button" class="btn btn-xs btn-ghost btn-circle chip-remove" title="Entfernen">✕</button>
							</div>
						}
					</div>
				}
				<div id="attachment-list" class="flex flex-col gap-2 w-full">
					<div class="flex items-center gap-2 w-full">
						<input type="file" name="files" class="file-input file-input-bordered w-full" />
						<button type="button" class="btn btn-sm btn-ghost btn-circle attachment-remove" title="Entfernen">✕</button>
					</div>
				</div>
				<button type="button" id="add-attachment" class="btn btn-sm btn-outline mt-2 w-fit">Anhang hinzufügen</button>
				if fieldErrors["files"] != "" {
					<span class="text-error text-sm mt-1">{fieldErrors["files"]}</span>
				}
			</div>

			@ui_components.SubmitButton("Senden", ui_components.Primary)
		</form>
	}
}
