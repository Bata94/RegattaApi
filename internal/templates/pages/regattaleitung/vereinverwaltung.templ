package regattaleitung

import (
	"github.com/bata94/RegattaApi/internal/crud"
	"github.com/bata94/RegattaApi/internal/templates/components"
	"github.com/google/uuid"
)

templ Vereinsverwaltung() {
	{{
		vereine, err := crud.GetAllVerein(ctx)
		rows := []ui_components.TableRowParams{}
	}}
	if err != nil {
		@ui_components.ErrorBody(500, err.Error())
		{{return}}
	}

	{{
		for _, v := range vereine {
			rows = append(rows, ui_components.TableRowParams{
				ID: v.Uuid.String(),
				Content: []string{
					v.Name,
					v.Kurzform,
					v.Kuerzel,
				},
				OnClickDialogSrc: "/internal/regattaleitung/vereine/" + v.Uuid.String(),
			})
		}
	}}

	@ui_components.InternalPageDivCol() {
		<div class="flex flex-row justify-between items-center">
			@ui_components.PageHeader("Vereinsverwaltung")
			<button
				class="btn btn-primary ml-auto"
				hx-target="#table_dialog_content"
				hx-swap="innerHTML"
				hx-get="/internal/regattaleitung/vereine/new"
				hx-trigger="click"
				hx-boost="true"
				onclick="table_dialog.showModal()"
			>
				Neuer Verein
			</button>
		</div>

		@ui_components.Table(ui_components.TableParams{
			Zebra: true,
			Columns: []ui_components.TableColumnParams{
				{Title: "Name", WidthClass: ""},
				{Title: "Kurzform", WidthClass: ""},
				{Title: "Kürzel", WidthClass: ""},
			},
			Rows: rows,
		})
	}
}

templ VereinEdit(v crud.Verein, msg string, fieldErrors map[string]string) {
	{{
		var title, uuidStr string
		isNew := v.Uuid == uuid.Nil
		if isNew {
			title = "Neuer Verein"
			uuidStr = "new"
		} else {
			title = "Verein bearbeiten"
			uuidStr = v.Uuid.String()
		}
	}}

	<div id="verein_edit_dialog" class="w-full flex flex-col">
		@ui_components.PageHeader(title)

		<form
			class="w-full mt-4"
			hx-post={"/internal/regattaleitung/vereine/" + uuidStr}
			hx-target="#verein_edit_dialog"
			hx-on::response="if (event.detail.xhr.getResponseHeader('HX-Redirect')) { table_dialog.close(); htmx.ajax('GET', '/internal/regattaleitung/vereine', {target: 'main', swap: 'innerHTML'}); }"
		>
			if msg != "" {
				<div class="alert alert-error mb-4">
					<span>{msg}</span>
				</div>
			}

			<div class="flex flex-col gap-4">
				@ui_components.LineInput("name", "Name", v.Name, "text", true, fieldErrors["name"])
				@ui_components.LineInput("kurzform", "Kurzform", v.Kurzform, "text", true, fieldErrors["kurzform"])
				@ui_components.LineInput("kuerzel", "Kürzel", v.Kuerzel, "text", true, fieldErrors["kuerzel"])
			</div>

			<div class="flex flex-row items-center gap-4 mt-4">
				@ui_components.SubmitButton("Speichern", ui_components.Success)
				if !isNew {
					<button
						type="button"
						class="btn btn-error mt-6"
						hx-delete={"/internal/regattaleitung/vereine/" + uuidStr}
						hx-target="main"
						hx-swap="innerHTML"
						hx-confirm="Verein wirklich löschen?"
						hx-on::after-request="if (event.detail.successful) table_dialog.close()"
					>
						Löschen
					</button>
				}
			</div>
		</form>
	</div>
}
