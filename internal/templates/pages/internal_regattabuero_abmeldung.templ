package ui_pages

import (
  "github.com/bata94/RegattaApi/internal/crud"
  "github.com/bata94/RegattaApi/internal/templates/components"
)

templ InternalRegattabueroAbmeldung(meldungen []crud.Meldung) {
  <div class="max-w-[90%] mx-auto my-4 flex flex-col gap-4">
    @ui_components.PageHeader("Abmeldung")
    for _, m := range meldungen {
      <div
        class="card bg-base-100 shadow-md"
      >
        <div class="card-body">
          <h5 class="card-title">{m.StartNummer}</h5>
        </div>
      </div>
    }
  </div>
}
