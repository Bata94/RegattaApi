package dashboard

import "github.com/bata94/RegattaApi/internal/templates/components"

templ Dashboard(userCaps []string) {
  @ui_components.InternalPageDivCol() {
    <div class="max-w-3xl mx-auto text-center">
      <div class="mb-8">
        <h1 class="text-3xl font-bold !m-0 text-mrgblau">Willkommen im internen Bereich</h1>
        <p class="text-base-content/70 mt-2">MRG Regatta — Interne Verwaltung</p>
      </div>

      <div class="card bg-base-200 shadow-sm">
        <div class="card-body items-center text-center p-8">
          <div class="avatar placeholder mb-4">
            <div class="bg-mrgblau text-neutral-content rounded-full w-20 h-20 flex items-center justify-center">
              <svg class="w-10 h-10" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
          </div>

          <p class="text-base-content/80 mb-6">
            Wähle über die Seitenleiste eine Kategorie aus, um die jeweiligen Funktionen zu nutzen.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full max-w-md text-left">
            for _, cap := range userCaps {
              switch cap {
              case "allowed_zeitnahme":
                <div
                  class="card card-compact bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer"
                  hx-get="/internal/zeitnahme"
                  hx-target="#main-content"
                  hx-push-url="true"
                >
                  <div class="card-body items-center text-center">
                    <svg class="w-8 h-8 text-mrgblau mb-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <h3 class="card-title text-sm !m-0">Zeitnahme</h3>
                  </div>
                </div>
              case "allowed_startlisten":
                <div
                  class="card card-compact bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer"
                  hx-get="/internal/startlisten"
                  hx-target="#main-content"
                  hx-push-url="true"
                >
                  <div class="card-body items-center text-center">
                    <svg class="w-8 h-8 text-mrgblau mb-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                    <h3 class="card-title text-sm !m-0">Startlisten</h3>
                  </div>
                </div>
              case "allowed_regattabuero":
                <div
                  class="card card-compact bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer"
                  hx-get="/internal/regattabuero"
                  hx-target="#main-content"
                  hx-push-url="true"
                >
                  <div class="card-body items-center text-center">
                    <svg class="w-8 h-8 text-mrgblau mb-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    <h3 class="card-title text-sm !m-0">Regattabüro</h3>
                  </div>
                </div>
              case "allowed_regattaleitung":
                <div
                  class="card card-compact bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer"
                  hx-get="/internal/regattaleitung"
                  hx-target="#main-content"
                  hx-push-url="true"
                >
                  <div class="card-body items-center text-center">
                    <svg class="w-8 h-8 text-mrgblau mb-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    <h3 class="card-title text-sm !m-0">Regattaleitung</h3>
                  </div>
                </div>
              case "allowed_admin":
                <div
                  class="card card-compact bg-base-100 shadow-sm hover:shadow-md transition-shadow cursor-pointer"
                  hx-get="/internal/admin"
                  hx-target="#main-content"
                  hx-push-url="true"
                >
                  <div class="card-body items-center text-center">
                    <svg class="w-8 h-8 text-mrgblau mb-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    <h3 class="card-title text-sm !m-0">Admin</h3>
                  </div>
                </div>
              }
            }
          </div>
        </div>
      </div>
    </div>
  }
}
