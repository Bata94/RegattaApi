package ui_pages

import (
  "fmt"

  "github.com/google/uuid"

  "github.com/bata94/RegattaApi/internal/templates/components"
  "github.com/bata94/RegattaApi/internal/crud"
)

type ProfilData struct {
  Uuid         uuid.UUID
	Username     string
	UserGroup    string
	Capabilities []string
}

templ Profil(data ProfilData) {
  {{
    breadcrumbs := []ui_components.BreadcrumbsEntries{
      ui_components.BreadcrumbsEntries{
        Title: "Home",
        Paths: "/",
      },
      ui_components.BreadcrumbsEntries{
        Title: "Internes",
        Paths: "/internal",
      },
      ui_components.BreadcrumbsEntries{
        Title: "Profil",
        Paths: "/internal/profil",
      },
    }
  }}
  @ui_components.Breadcrumbs(breadcrumbs)
    @ui_components.InternalPageDivCol() {
      @ui_components.PageHeader("Profil")
      @ui_components.PageHeaderSubtext("Hier kannst du dein Profil verwalten.")

      <div class="w-md mx-auto mt-8">
        <div class="card bg-base-200 shadow-xl">
          <div class="card-body">
            <div class="">
              <p><span class="font-bold">Benutzername:</span> {data.Username}</p>
              if data.UserGroup != "" {
                <p><span class="font-bold">Benutzergruppe:</span> {data.UserGroup}</p>
              }
              if len(data.Capabilities) > 0 {
                <p><span class="font-bold">Berechtigungen:</span></p>
                <ul class="list-disc list-inside">
                  for _, cap := range data.Capabilities {
                    <li>{cap}</li>
                  }
                </ul>
              }
            </div>
            <div class="card-actions justify-between mt-4">
              <a
                href={fmt.Sprintf("/internal/profil/password/%s", data.Uuid)}
                class="btn btn-warning"
                hx-target="#password_dialog_content"
                hx-swap="innerHTML"
                hx-get={fmt.Sprintf("/internal/profil/password/%s", data.Uuid)}
                hx-trigger="click"
                hx-boost="true"
                onclick="password_dialog.showModal()"
              >
                Passwort ändern
              </a>
              <a href="/logout" class="btn btn-error">Abmelden</a>
            </div>
          </div>
      </div>
    </div>

    @ui_components.DialogDataEdit("Passwort ändern", "password_dialog")
  }
}

templ ChangePasswordDialogBody(u crud.User, msg string) {
  <div
    class="w-full flex flex-col"
    id="password_dialog_content"
  >
    <form
      hx-put={"/internal/profil/password/" + u.Uuid.String()}
      hx-target="#password_dialog_content"
      hx-on::response="if (event.detail.xhr.getResponseHeader('HX-Redirect')) { password_dialog.close(); htmx.ajax('GET', '/internal/admin/users', {target: 'main', swap: 'innerHTML'}); }"
    >
      if msg != "" {
        <div class="alert alert-error mb-4">
          <span>{msg}</span>
        </div>
      }

      <div class="form-control mb-6">
        <label class="input w-full">
          <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
          <input
            type="password"
            name="current_password"
            class="grow"
            placeholder="Aktuelles Passwort"
            required
          />
        </label>
      </div>

      <div class="divider"/>

      <div class="form-control mb-6">
        <label class="input w-full">
          <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
          <input
            type="password"
            name="new_password_1"
            class="grow"
            placeholder="Neues Passwort"
            required
          />
        </label>
      </div>
      <div class="form-control mb-6">
        <label class="input w-full">
          <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
          <input
            type="password"
            name="new_password_2"
            class="grow"
            placeholder="Neues Passwort erneut"
            required
          />
        </label>
      </div>

      @ui_components.SubmitButton("Speichern", ui_components.Success)
    </form>
  </div>
}
