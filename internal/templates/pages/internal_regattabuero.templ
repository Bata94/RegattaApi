package ui_pages

import "github.com/bata94/RegattaApi/internal/templates/components"

templ InternalRegattabuero() {
  <div class="w-full flex flex-col">
    <h2>Regattabüro</h2>
    <p>Hier kannst du die Regattabüro-Funktionen nutzen.</p>

    <div
      class="btn btn-outline min-w-64 w-1/2 h-20 mx-auto mb-8"
      hx-get="/internal/regattabuero"
      hx-target="main"
      hx-push-url="true"
      hy-boost="true"
      href="/internal/regattabuero"
    >
      <h2 class="text-2xl font-bold !m-0">
        Neues Dashboard (Beta)
      </h2>
    </div>

    @ui_components.InternalNavBtnGrid([]ui_components.InternalNavBtnParams{
      {Name: "Abmeldung", Desc: "", URL: "#"},
      {Name: "Ummeldung", Desc: "", URL: "#"},
      {Name: "Nachmeldung", Desc: "", URL: "#"},
      {Name: "Waage", Desc: "", URL: "#"},
      {Name: "Startberechtigung", Desc: "", URL: "#"},
      {Name: "Sportler anlegen", Desc: "", URL: "#"},
      {Name: "Kasse", Desc: "", URL: "#"},
      {Name: "Startnummern Ausgabe/Rückgabe", Desc: "", URL: "#"},
      {Name: "Startnummern ändern", Desc: "", URL: "#"},
      {Name: "Setzungsänderung", Desc: "", URL: "#"},
      {Name: "Änderungen von Obleuten", Desc: "", URL: "#"},
    })
  </div>
}
