package ui_pages

import "github.com/bata94/RegattaApi/internal/templates/components"

templ InternalRegattabuero() {
  <div class="w-full flex flex-col">
    <h2>Regattabüro</h2>
    <p>Hier kannst du die Regattabüro-Funktionen nutzen.</p>

    <div
      class="btn btn-outline min-w-64 w-1/2 h-20 mx-auto mb-8"
      hx-get="/internal/regattabuero"
      hx-target="main"
      hx-push-url="true"
      hy-boost="true"
      href="/internal/regattabuero"
    >
      <h2 class="text-2xl font-bold !m-0">
        Neues Dashboard (Beta)
      </h2>
    </div>

    @ui_components.InternalNavBtnGrid([]ui_components.InternalNavBtnParams{
      {Name: "Abmeldung", Desc: "Meldungen abmelden", URL: "#"},
      {Name: "Ummeldung", Desc: "Meldungen ummelden", URL: "#"},
      {Name: "Nachmeldung", Desc: "Meldung nachmelden", URL: "#"},
      {Name: "Waage", Desc: "Sportler verwiegen", URL: "#"},
      {Name: "Startberechtigung", Desc: "Ärztliche Bescheinigung überprüfen", URL: "#"},
      {Name: "Sportler anlegen", Desc: "Neuen Sportler anlegen", URL: "#"},
      {Name: "Kasse", Desc: "Einzahlungen kassieren, Rechnungen und Quittungen einsehen", URL: "#"},
      {Name: "Startnummern Ausgabe/Rückgabe", Desc: "Startnummern ausgeben oder zurücknehmen", URL: "#"},
      {Name: "Startnummern ändern", Desc: "Startnummer einer Meldung ändern", URL: "#"},
      {Name: "Setzungsänderung", Desc: "Setzung eines Rennens ändern", URL: "#"},
      {Name: "Änderungen von Obleuten", Desc: "Ab-, Um- und Nachmeldungen von Vereins Obleuten akzeptieren bzw. ablehnen", URL: "#"},
    })
  </div>
}
