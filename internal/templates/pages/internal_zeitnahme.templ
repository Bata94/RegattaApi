package ui_pages

import "github.com/bata94/RegattaApi/internal/templates/components"

templ InternalZeitnahme() {
  {{
    breadcrumbs := []ui_components.BreadcrumbsEntries{
      ui_components.BreadcrumbsEntries{
        Title: "Home",
        Paths: "/",
      },
      ui_components.BreadcrumbsEntries{
        Title: "Internes",
        Paths: "/internal",
      },
      ui_components.BreadcrumbsEntries{
        Title: "Zeitnahme",
        Paths: "/internal/zeitnahme",
      },
    }
  }}
  @ui_components.Breadcrumbs(breadcrumbs)
  @ui_components.InternalPageDivCol() {

    @ui_components.PageHeader("Zeitnahme")
    @ui_components.PageHeaderSubtext("Hier kannst du die Zeitnahme-Funktionen nutzen.")

    @ui_components.InternalNavBtnGrid([]ui_components.InternalNavBtnParams{
      {Name: "Vorsortierung", Desc: "", URL: "#"},
      {Name: "Startgericht", Desc: "", URL: "#"},
      {Name: "Zielgericht", Desc: "", URL: "#"},
    })
  }
}
