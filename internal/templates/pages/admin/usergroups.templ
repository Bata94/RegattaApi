package admin

import (
  "github.com/bata94/RegattaApi/internal/templates/components"
  "github.com/bata94/RegattaApi/internal/crud"
	"github.com/bata94/RegattaApi/internal/sqlc"
	"time"
)

templ UserGroups() {
  {{
    userGroups, err:= crud.GetAllUsersGroups(ctx)
    groupRows := []ui_components.TableRowParams{}
  }}
  if err != nil {
    @ui_components.ErrorBody(500, err.Error())
    {{return}}
  }

  {{
    capLabels := map[sqlc.UserCapability]string{
      sqlc.UserCapabilityAllowedAdmin:          "Admin",
      sqlc.UserCapabilityAllowedZeitnahme:      "Zeitnahme",
      sqlc.UserCapabilityAllowedStartlisten:    "Startlisten",
      sqlc.UserCapabilityAllowedRegattabuero:   "Büro",
      sqlc.UserCapabilityAllowedRegattaleitung: "Leitung",
    }

    for _, g := range userGroups {
      capsStr := ""
      for i, c := range g.Capabilities {
        if i > 0 {
          capsStr += ", "
        }
        if label, ok := capLabels[c]; ok {
          capsStr += label
        } else {
          capsStr += string(c)
        }
      }
      groupRows = append(groupRows, ui_components.TableRowParams{
        ID: g.Uuid.String(),
        Content: []string{
          g.Name,
          capsStr,
          time.Unix(g.Uuid.Time().UnixTime()).Format("02.01.2006 15:04"),
        },
        OnClickDialogSrc: "/internal/admin/usergroups/" + g.Uuid.String(),
      })
    }

  }}

  @ui_components.InternalPageDivCol() {
  <div class="flex flex-row justify-between items-center">
    @ui_components.PageHeader("Nutzergruppen")
      <button
        class="btn btn-primary ml-auto"
        hx-target="#table_dialog_content"
        hx-swap="innerHTML"
        hx-get="/internal/admin/usergroups/new"
        hx-trigger="click"
        hx-boost="true"
        onclick="table_dialog.showModal()"
      >
        Neue Nutzergruppe
      </button>
    </div>

    @ui_components.Table(ui_components.TableParams{
      Zebra: true,
      Columns: []ui_components.TableColumnParams{
        {Title: "Gruppenname", WidthClass: ""},
        {Title: "Berechtigungen", WidthClass: ""},
        {Title: "Erstellt am", WidthClass: ""},
      },
      Rows: groupRows,
    })
  }
}
