templ InternalRegattabueroNewAthlet(v crud.Verein, msg string, fieldErrors map[string]string) {
  {{
    breadcrumbs := []ui_components.BreadcrumbsEntries{
      ui_components.BreadcrumbsEntries{
        Title: "Home",
        Paths: "/",
      },
      ui_components.BreadcrumbsEntries{
        Title: "Internes",
        Paths: "/internal",
      },
      ui_components.BreadcrumbsEntries{
        Title: "Regattabüro",
        Paths: "/internal/regattabuero",
      },
      ui_components.BreadcrumbsEntries{
        Title: "Neuer Athlet",
        Paths: "",
      },
    }
  }}

  @ui_components.Breadcrumbs(breadcrumbs)
  @ui_components.InternalPageDivCol() {
    @ui_components.PageHeader("Neuen Sportler anlegen für " + v.Name)
    @ui_components.PageHeaderSubtext("")

    if msg != "" {
      <div class="alert alert-error mb-4">
        <span>{msg}</span>
      </div>
    }

    <form
      hx-post={"/internal/regattabuero/" + v.Uuid.String() + "/new_athlet"}
      hx-target="main"
      hx-push-url="true"
    >
      <div class="flex flex-col gap-4 w-full md:w-2/3 lg:w-1/2 md:mx-auto mt-4">
        @ui_components.LineInput("vorname", "Vorname", "", "text", true, fieldErrors["vorname"])
        @ui_components.LineInput("name", "Name", "", "text", true, fieldErrors["name"])
        @ui_components.LineInput("jahrgang", "Jahrgang", "", "text", true, fieldErrors["jahrgang"])
        @ui_components.GenderSelect("geschlecht", "m", fieldErrors["geschlecht"])
        @ui_components.Toggle("startberechtigt", "Startberechtigt", false, false, fieldErrors["startberechtigt"])
        <div class="flex flex-row gap-4 justify-center my-4">
          @ui_components.SubmitButton("Speichern", ui_components.Success)
          <button
            type="button"
            class="btn btn-primary mt-6"
            hx-get="/internal/regattabuero/vereinswahl?next=new_athlet&title=Vereinswahl%20für%20Neuen%20Sportler%20anlegen"
            hx-target="main"
            hx-push-url="true"
          >
            Abbrechen
          </button>
        </div>
      </div>
    </form>
  }
}

templ InternalRegattabueroNewAthletSuccess(a crud.Athlet) {
  {{
    breadcrumbs := []ui_components.BreadcrumbsEntries{
      ui_components.BreadcrumbsEntries{
        Title: "Home",
        Paths: "/",
      },
      ui_components.BreadcrumbsEntries{
        Title: "Internes",
        Paths: "/internal",
      },
      ui_components.BreadcrumbsEntries{
        Title: "Regattabüro",
        Paths: "/internal/regattabuero",
      },
      ui_components.BreadcrumbsEntries{
        Title: "Neuen Athlet anlegen",
        Paths: fmt.Sprintf("/internal/regattabuero/%s/new_athlet", a.Verein.Uuid.String()),
      },
      ui_components.BreadcrumbsEntries{
        Title: "Athlet erfolgreich angelegt",
        Paths: "",
      },
    }
  }}

  @ui_components.Breadcrumbs(breadcrumbs)
  @ui_components.InternalPageDivCol() {
    @ui_components.PageHeader(fmt.Sprintf("Sportler %s erfolgreich angelegt", a.FullName()))
    @ui_components.PageHeaderSubtext("")

    @ui_components.TeilnehmerCard(a, ui_components.NoNavHXNavigationOptions())

    <button
      type="button"
      class="btn btn-primary mt-6 mx-auto"
      hx-get="/internal/regattabuero/vereinswahl?next=new_athlet&title=Vereinswahl%20für%20Neuen%20Sportler%20anlegen"
      hx-target="main"
      hx-push-url="true"
    >
      Zurück
    </button>
  }
}
