package ui_pages

import "github.com/bata94/RegattaApi/internal/templates/components"

templ InternalAdmin() {
  <div class="w-full flex flex-col">
    <h2>Admin</h2>
    <p>Hier kannst du die Admin-Funktionen nutzen.</p>

    @ui_components.InternalNavBtnGrid([]ui_components.InternalNavBtnParams{
